<Window x:Class="RawMetalCampaignEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="RAW METAL // CAMPAIGN EDITOR"
        Width="1680" Height="980" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="#EEF3F8">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1319" Offset="0"/>
            <GradientStop Color="#131C26" Offset=".55"/>
            <GradientStop Color="#0A0F16" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <LinearGradientBrush x:Key="GlassBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2E4258" Offset="0"/>
            <GradientStop Color="#18222F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="#5F7E9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity=".55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EEF3F8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11" BorderThickness="1" BorderBrush="#56708C"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#41546E" Offset="0"/>
                                    <GradientStop Color="#1E2A3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0C987"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value=".75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldBtn" TargetType="Button" BasedOn="{StaticResource TopBtn}">
            <Setter Property="Foreground" Value="#14100A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11" BorderThickness="1" BorderBrush="#FFE1A0"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F4C96B" Offset="0"/>
                                    <GradientStop Color="#DFA83E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#DCE6F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" BorderThickness="1" BorderBrush="#4C6076"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33465C" Offset="0"/>
                                    <GradientStop Color="#1C2836" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0C987"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8B860"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E2A3A"/>
            <Setter Property="Foreground" Value="#EEF3F8"/>
            <Setter Property="BorderBrush" Value="#4C6076"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tg" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="9" BorderThickness="1" BorderBrush="#4C6076" Padding="8,5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#33465C" Offset="0"/>
                                                    <GradientStop Color="#1C2836" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Text="▾" HorizontalAlignment="Right" Foreground="#F0C987" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1B2635" BorderBrush="#5F7E9E" BorderThickness="1" CornerRadius="9" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#DCE6F0"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="b" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#38506E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#46688C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#131C26"/>
            <Setter Property="Foreground" Value="#EEF3F8"/>
            <Setter Property="BorderBrush" Value="#4C6076"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C2D2E4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0"
                                Background="#1B2635" BorderBrush="#4C6076" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#38506E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Style="{StaticResource Glass}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RAW METAL  //  CAMPAIGN EDITOR" FontSize="21" FontWeight="Bold" Foreground="#E8B860"/>
                    <TextBlock Text="Paint rooms. Watch them in 3D. Walk inside. Ship real .rmc worlds."
                               Foreground="#A9BCD2" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" x:Name="ToolbarPanel" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="238"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="348"/>
            </Grid.ColumnDefinitions>

            <!-- Tools rail -->
            <Border x:Name="ToolsDock" Grid.Column="0" Style="{StaticResource Glass}" Padding="14,10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ToolsRail">
                        <TextBlock Text="🗺 Maps in this campaign" Style="{StaticResource RailLabel}" Margin="2,0,0,8"/>
                        <TextBox x:Name="MapSearch" ToolTip="Find a map by number or name"/>
                        <ListBox x:Name="MapList" Height="110" Background="#131C26" Foreground="#EEF3F8"
                                 BorderBrush="#4C6076" FontSize="13"/>
                        <Button x:Name="AddMapBtn" Content="＋ Add a map (next door)" Style="{StaticResource TopBtn}" Margin="0,8,0,10"/>
                        <TextBlock Text="🛠  TOOLS" Style="{StaticResource RailLabel}" Margin="2,0,0,8"/>
                        <StackPanel x:Name="ToolsPanel"/>
                        <TextBlock Text="Person to place" Style="{StaticResource RailLabel}"/>
                        <ComboBox x:Name="SpawnRoleCombo"/>
                        <TextBlock Text="Shape to place" Style="{StaticResource RailLabel}"/>
                        <ComboBox x:Name="PrimKindCombo"/>
                        <TextBlock Text="Put things at" Style="{StaticResource RailLabel}"/>
                        <ComboBox x:Name="HeightCombo"/>
                        <TextBlock Text="Floors" Style="{StaticResource RailLabel}"/>
                        <ListBox x:Name="LayerList" Height="86" Background="#131C26" Foreground="#EEF3F8"
                                 BorderBrush="#4C6076" FontSize="13"/>
                        <Button x:Name="AddFloorBtn" Content="＋ Add a floor above" Style="{StaticResource TopBtn}" Margin="0,8,0,0"/>
                        <TextBlock Text="Room finishes (the game's own)" Style="{StaticResource RailLabel}"/>
                        <TextBlock Text="Walls" Foreground="#A9BCD2" FontSize="12"/>
                        <ComboBox x:Name="SurfWallCombo"/>
                        <TextBlock Text="Floor" Foreground="#A9BCD2" FontSize="12"/>
                        <ComboBox x:Name="SurfFloorCombo"/>
                        <TextBlock Text="Ceiling" Foreground="#A9BCD2" FontSize="12"/>
                        <ComboBox x:Name="SurfCeilCombo"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Dual view -->
            <Border Grid.Column="1" Style="{StaticResource Glass}" Padding="7" Margin="0,0,10,0">
                <Grid x:Name="ViewGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlanCol" Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition x:Name="GlCol" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="10" Background="#0D1117" BorderBrush="#41546E" BorderThickness="1" ClipToBounds="True">
                        <wf:WindowsFormsHost x:Name="PlanHost"/>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Column="2" CornerRadius="10" Background="#090C10" BorderBrush="#41546E" BorderThickness="1" ClipToBounds="True">
                        <wf:WindowsFormsHost x:Name="GlHost"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right dock -->
            <Border x:Name="RightDock" Grid.Column="2" Style="{StaticResource Glass}" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="🧩 Parts">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="PartSearch" ToolTip="Search models"/>
                            <ComboBox x:Name="PartCatCombo" Grid.Row="1"/>
                            <ListBox x:Name="PartsList" Grid.Row="2" Background="#101823" BorderBrush="#4C6076"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96" Margin="3">
                                            <Border Height="60" CornerRadius="9" Background="#1B2635" BorderBrush="#41546E" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Emoji}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".75"/>
                                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="3"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#DCE6F0" MaxHeight="30"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="🎨 Finishes">
                        <ListBox x:Name="MatsList" Margin="0,8,0,0" Background="#101823" BorderBrush="#4C6076"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="104" Margin="4">
                                        <Border Height="64" CornerRadius="8" Background="#1B2635" BorderBrush="#41546E" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" Margin="3"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#DCE6F0"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="🌍 Outdoors">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,6,0">
                                <CheckBox x:Name="TerrainOn" Content="Outdoor terrain in this campaign" Foreground="#DCE6F0" FontSize="13.5" Margin="0,4,0,10"/>
                                <TextBlock Text="Hills (the game's own heightfield)" Foreground="#E8B860" FontWeight="Bold" Margin="0,2,0,6"/>
                                <TextBlock Text="Seed" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="TSeed"/>
                                <TextBlock Text="Ground level (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="TBase"/>
                                <TextBlock Text="Hill height (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="TAmp"/>
                                <TextBlock Text="Hill size (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="TScale"/>
                                <TextBlock Text="Ruggedness 0-0.9" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="TRough"/>
                                <TextBlock Text="Treeline on the horizon" Foreground="#E8B860" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="Depth (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="HDepth"/>
                                <TextBlock Text="Tree spacing (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="HSpacing"/>
                                <TextBlock Text="Rise (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="HRise"/>
                                <TextBlock Text="🌱 Ground to paint" Foreground="#E8B860" FontWeight="Bold" Margin="0,8,0,6"/>
                                <ComboBox x:Name="GroundKindCombo"/>
                                <TextBlock Text="🛣 Flatten-pad height (m)" Foreground="#A9BCD2" FontSize="12"/><TextBox x:Name="FlatHeight" Text="1"/>
                                <TextBlock Text="Painted ground &amp; pads" Foreground="#E8B860" FontWeight="Bold" Margin="0,8,0,6"/>
                                <ListBox x:Name="GroundList" Height="150" Background="#131C26" Foreground="#DCE6F0" BorderBrush="#4C6076" FontSize="12"/>
                                <Button x:Name="DelGroundBtn" Content="Remove selected" Style="{StaticResource TopBtn}" Margin="0,8,0,0"/>
                                <TextBlock Text="Paint with the 🌱 Ground paint and 🛣 Flatten tools (left rail): drag a rectangle on the plan. Buildings sit on pads; grass goes everywhere else. 📸 ENGINE SHOT shows the real hills."
                                           Foreground="#A9BCD2" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🔧 Inspector">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="InspectorPanel"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="📋 Guide">
                        <TextBlock x:Name="ChecklistText" Margin="6,12,6,6" FontSize="14" LineHeight="24"
                                   Foreground="#C2D2E4" TextWrapping="Wrap"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="14,4" Margin="0,10,0,0" CornerRadius="10">
            <TextBlock x:Name="StatusText" Foreground="#F0C987" FontSize="13" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>


